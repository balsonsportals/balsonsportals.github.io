var STORE_DEFAULT_SS_ID = '1u_ZKvvCVfEQDAtkoMR68q2d2hEK-eWBnvsS3AGfP6yQ';

function initStoreDatabase(targetSpreadsheetId) {
  var ssId = targetSpreadsheetId || PropertiesService.getScriptProperties().getProperty('STORE_SPREADSHEET_ID') || STORE_DEFAULT_SS_ID;
  if (!ssId) {
    throw new Error('Target Spreadsheet ID not provided. Set STORE_SPREADSHEET_ID in Script Properties or pass as parameter.');
  }

  var ss = SpreadsheetApp.openById(ssId);
  if (!ss) throw new Error('Spreadsheet unreachable for ID: ' + ssId);

  var SCHEMAS = [
    // 1. Core Config & Master Schemas
    ['SYSTEM_CONFIG', ['ConfigKey', 'ConfigValue', 'Description', 'EffectiveDate', 'UpdatedBy']],
    ['USER_ROLES', ['UserID', 'Username', 'FullName', 'Role', 'AssignedSection', 'IsActive']],
    ['INVENTORY_MASTER', [
      'ToolID', 'SectionCode', 'SectionName', 'TypeCode', 'Description', 'Specification', 
      'CapacitySWL', 'Manufacturer', 'Model', 'IsLiftingStatutory', 'Form11CertNo', 
      'LastInspectionDate', 'NextInspectionDue', 'Status', 'BinLocation', 'IssuedTo', 'IssuedDate', 'Condition'
    ]],
    ['FORM11_LIFTING_REGISTER', [
      'ItemNo', 'ToolID', 'DescriptionAndSWL', 'SafeWorkingAngle', 'ProofLoadTons', 
      'LastInspectionDate', 'NextInspectionDue', 'CertNumber', 'CompetentPerson', 'ComplianceStatus', 'Remarks'
    ]],
    ['TOOL_LOANS_REGISTER', [
      'TxID', 'ToolID', 'ToolDescription', 'BorrowerEmpID', 'BorrowerName', 'BorrowerTrade', 
      'Department', 'JobLocationArea', 'IssueDateTime', 'ExpectedReturn', 'ActualReturn', 
      'LoanStatus', 'WorkPurpose', 'ConditionIssued', 'ConditionReturned', 'IssuedBy'
    ]],
    ['QUARANTINE_RED_TAG_LOG', [
      'RedTagID', 'ToolID', 'ToolDescription', 'QuarantineDate', 'QuarantinedBy', 
      'DefectCategory', 'DefectDetail', 'ActionTaken', 'Resolution', 'QuarantineStatus'
    ]],
    ['MRN_GRN_INWARD_REGISTER', [
      'GrnNo', 'ReceiptDate', 'PoNo', 'VendorName', 'ChallanNo', 'ItemDescription', 
      'OrderedQty', 'ReceivedQty', 'AcceptedQty', 'RejectedQty', 'Unit', 'InspectionStatus', 'InspectedBy', 'Remarks'
    ]],
    ['RGP_NRGP_GATEPASS_LOG', [
      'PassNo', 'PassType', 'IssueDate', 'ConsigneeDestination', 'PurposeWorkOrder', 
      'ExpectedReturnDate', 'AuthorizedBy', 'SecurityGateSign', 'Status', 'ClosureDate'
    ]],
    ['PROCUREMENT_REQUISITIONS', [
      'PrID', 'ItemDescription', 'Category', 'Quantity', 'Unit', 'RequestedBy', 
      'RequiredByDate', 'EstimatedCost', 'Justification', 'ApprovalStatus'
    ]],
    ['VENDOR_MASTER', [
      'VendorID', 'VendorName', 'Category', 'ContactPerson', 'Phone', 'Email', 'GSTIN', 'Rating'
    ]],
    ['AUDIT_LOG', [
      'AuditID', 'Timestamp', 'Actor', 'Role', 'Action', 'EntityRef', 'Outcome', 'Details'
    ]]
  ];

  Logger.log('Provisioning ' + SCHEMAS.length + ' Relational Store Sheets in: ' + ss.getName());

  SCHEMAS.forEach(function(item) {
    var name = item[0];
    var headers = item[1];
    var sheet = ss.getSheetByName(name);
    if (!sheet) {
      sheet = ss.insertSheet(name);
    }
    // Set Header Row
    sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
    sheet.getRange(1, 1, 1, headers.length)
      .setBackground('#102D35')
      .setFontColor('#FFFFFF')
      .setFontWeight('bold')
      .setFontFamily('Arial')
      .setFontSize(10);
    sheet.setRowHeight(1, 30);
    sheet.setFrozenRows(1);
  });

  // Seed baseline data
  seedStoreMasterData(ss);

  return 'BALSONS Store Database Provisioned Successfully in ' + ss.getName() + ' (' + ssId + ')';
}

